:root{
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:#0f172a;background:#f6f8f7;font-synthesis:none;text-rendering:optimizeLegibility;
  --navy:#0e2430;--navy-2:#173744;--teal:#0f766e;--teal-2:#14b8a6;--aqua:#d9f7f3;--line:#dce5e3;
  --muted:#64748b;--white:#fff;--orange:#f59e0b;--danger:#ef4444;--green:#16a34a;--radius:22px;
}
*{box-sizing:border-box}body{margin:0;min-width:320px;background:#f5f7f6}button,input,select,textarea{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(1.75rem,3vw,2.55rem);line-height:1.08;letter-spacing:-.04em}h2{letter-spacing:-.025em}p{color:var(--muted);line-height:1.65}.app-shell{min-height:100vh}.app-main{margin-left:258px;min-height:100vh;transition:.25s}.app-shell.is-collapsed .app-main{margin-left:86px}.sidebar{position:fixed;inset:0 auto 0 0;width:258px;background:var(--navy);color:#e8f2f0;display:flex;flex-direction:column;padding:18px 14px;z-index:40;transition:.25s}.sidebar.collapsed{width:86px}.sidebar-brand{display:flex;align-items:center;gap:12px;padding:4px 8px 20px}.sidebar-brand strong{display:block;font-size:19px}.sidebar-brand span:not(.brand-mark){display:block;color:#9bb3b4;font-size:11px;margin-top:3px}.brand-mark{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#2dd4bf,#86efac);color:#0e2430;font-weight:900;box-shadow:0 10px 30px rgba(45,212,191,.2)}.sidebar-nav{display:flex;flex-direction:column;gap:4px;overflow:auto}.nav-item{display:flex;align-items:center;gap:12px;border:0;background:transparent;color:#b9caca;padding:11px 13px;border-radius:13px;font-weight:700;text-align:left}.nav-item:hover,.nav-item.active{background:rgba(255,255,255,.09);color:#fff}.nav-item.active{box-shadow:inset 3px 0 0 #2dd4bf}.nav-item.logout{margin-top:auto}.collapsed .nav-item{justify-content:center}.mobile-close{display:none!important;margin-left:auto}.top-header{height:76px;background:rgba(255,255,255,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 30px;position:sticky;top:0;z-index:30}.header-left,.header-actions,.page-actions,.device-actions{display:flex;align-items:center;gap:10px}.icon-btn{border:0;background:transparent;width:40px;height:40px;border-radius:12px;display:inline-grid;place-items:center;color:#456066}.icon-btn:hover{background:#eef4f2}.header-search{width:min(360px,36vw);height:42px;border:1px solid var(--line);background:#f8faf9;border-radius:14px;display:flex;align-items:center;gap:10px;padding:0 13px}.header-search input{border:0;outline:0;background:transparent;width:100%}.language-switch{border:1px solid var(--line);background:#fff;border-radius:999px;padding:5px;display:flex;gap:2px}.language-switch strong,.language-switch span{padding:6px 9px;border-radius:999px;font-size:12px}.language-switch strong{background:var(--navy);color:#fff}.user-chip{display:flex;align-items:center;gap:9px}.user-chip strong,.user-chip span{display:block}.user-chip span{font-size:11px;color:var(--muted)}.avatar,.big-avatar{display:grid;place-items:center;border-radius:50%;background:linear-gradient(135deg,#0f766e,#2dd4bf);color:#fff;font-weight:800}.avatar{width:38px;height:38px;font-size:12px}.badge-dot{position:relative}.badge-dot:after{content:"";position:absolute;right:9px;top:8px;width:7px;height:7px;background:#ef4444;border:2px solid #fff;border-radius:50%}.page-content{padding:30px;max-width:1600px;margin:0 auto}.page-header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}.page-header h1{margin-bottom:8px}.page-header p{margin:0;max-width:760px}.eyebrow{display:inline-block;color:var(--teal);font-size:12px;font-weight:900;letter-spacing:.14em;margin-bottom:10px}.panel{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:22px;box-shadow:0 12px 40px rgba(15,35,45,.045)}.summary-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:14px;margin-bottom:18px}.summary-card{min-height:132px;background:#fff;border:1px solid var(--line);border-radius:19px;padding:18px;display:flex;gap:14px;align-items:flex-start}.summary-card p{font-size:12px;font-weight:800;margin-bottom:8px}.summary-card h3{font-size:20px;margin-bottom:8px}.summary-card span{font-size:11px;color:var(--teal);font-weight:800}.summary-icon,.list-icon,.setting-icon{width:38px;height:38px;border-radius:12px;background:#e5f8f4;color:var(--teal);display:grid;place-items:center;flex:none}.tone-orange .summary-icon,.list-icon.orange{background:#fff3df;color:#d97706}.tone-navy .summary-icon{background:#e9eef1;color:var(--navy)}.tone-aqua .summary-icon{background:#dff8ff;color:#0891b2}.tone-gray .summary-icon{background:#eef2f4;color:#64748b}.dashboard-grid{display:grid;grid-template-columns:1.35fr .65fr;gap:18px}.dashboard-grid .wide{grid-column:auto}.panel-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.panel-head h2{font-size:18px;margin:0 0 5px}.panel-head p{margin:0;font-size:12px}.chart-wrap{height:285px}.pie-wrap{height:190px}.legend{display:grid;grid-template-columns:1fr 1fr;gap:10px}.legend span{font-size:12px;color:var(--muted)}.legend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:7px}.legend strong{float:right;color:#1e293b}.positive-pill,.trust-pill,.status-badge,.method-pill{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:7px 10px;font-size:11px;font-weight:900}.positive-pill,.trust-pill{background:#e5f8f4;color:var(--teal)}.status-badge.success{background:#e8f8ef;color:#15803d}.status-badge.pending{background:#fff3d7;color:#b45309}.status-badge.danger{background:#fee2e2;color:#b91c1c}.compact-list>div,.expense-list>div{display:flex;align-items:center;gap:12px;padding:13px 0;border-bottom:1px solid #edf1f0}.compact-list>div:last-child,.expense-list>div:last-child{border:0}.compact-list div div,.expense-list div div{flex:1}.compact-list strong,.compact-list small,.expense-list strong,.expense-list small{display:block}.compact-list small,.expense-list small{color:var(--muted);font-size:11px;margin-top:4px}.compact-list b,.expense-list b{font-size:13px}.insight-panel{background:linear-gradient(145deg,#0e2430,#164e55);color:#fff}.insight-panel p{color:#c6dcda}.insight-icon,.soft-icon{width:48px;height:48px;border-radius:15px;background:#d6fbf3;color:var(--teal);display:grid;place-items:center;margin-bottom:18px}.primary-btn,.secondary-btn{border-radius:999px;padding:11px 17px;border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-weight:900;font-size:13px}.primary-btn{background:var(--teal);color:#fff;box-shadow:0 10px 25px rgba(15,118,110,.18)}.primary-btn:hover{background:#0b655f}.secondary-btn{background:#fff;color:var(--navy);border-color:var(--line)}.secondary-btn:hover{background:#f3f7f6}.small{padding:9px 13px}.full{width:100%}.text-btn{border:0;background:transparent;color:var(--teal);font-weight:800;padding:0}.status-panel,.notice-card{min-height:142px}.device-mini{display:flex;align-items:center;gap:13px}.device-shape{width:56px;height:42px;border-radius:13px;background:var(--navy);color:#2dd4bf;display:grid;place-items:center;font-weight:900}.device-mini strong,.device-mini span{display:block}.device-mini span{font-size:11px;color:var(--muted);margin-top:3px}.status-bars,.meter,.progress-large{height:9px;background:#e8efed;border-radius:999px;overflow:hidden;margin-top:18px}.status-bars span,.meter i,.progress-large span{display:block;height:100%;background:linear-gradient(90deg,#0f766e,#2dd4bf);border-radius:inherit}.notice-card{display:flex;align-items:flex-start;gap:12px}.notice-card h3{font-size:14px;margin-bottom:6px}.notice-card p{font-size:12px;margin:0}.notice-dot{width:11px;height:11px;border-radius:50%;margin-top:4px}.notice-dot.warning{background:var(--orange)}.notice-dot.danger{background:var(--danger)}.segmented{display:inline-flex;background:#eaf0ee;padding:4px;border-radius:999px}.segmented button{border:0;background:transparent;padding:8px 13px;border-radius:999px;font-size:12px;font-weight:800;color:var(--muted)}.segmented button.active{background:#fff;color:var(--navy);box-shadow:0 5px 15px rgba(15,35,45,.08)}.toolbar{display:flex;gap:10px;align-items:center;margin-bottom:16px}.search-field{height:42px;border:1px solid var(--line);border-radius:13px;display:flex;align-items:center;gap:8px;padding:0 12px;flex:1;min-width:180px}.search-field input{border:0;outline:0;width:100%;background:transparent}.toolbar select,.form-grid select,.form-grid input,.form-grid textarea,.contact-card input,.contact-card textarea{border:1px solid var(--line);border-radius:13px;background:#fff;padding:11px 12px;outline:none;width:100%}.table-responsive{overflow:auto}.table-panel{padding:8px 18px}table{border-collapse:collapse;width:100%;min-width:900px}th,td{text-align:left;padding:15px 10px;border-bottom:1px solid #edf1f0;font-size:12px}th{color:#64748b;font-size:10px;text-transform:uppercase;letter-spacing:.06em}.table-title{display:flex;align-items:center;gap:9px}.method-pill{padding:6px 9px}.method-pill.qr{background:#dff7f3;color:#0f766e}.method-pill.cash{background:#f1f5f9;color:#475569}.method-pill.transfer{background:#e6efff;color:#1d4ed8}.method-pill.wallet{background:#f3e8ff;color:#7e22ce}.row-actions{display:flex}.row-actions button{border:0;background:transparent;color:#64748b;padding:7px}.modal-backdrop{position:fixed;inset:0;background:rgba(7,24,30,.55);backdrop-filter:blur(5px);display:grid;place-items:center;padding:18px;z-index:90}.modal{width:min(650px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:24px;padding:22px}.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.modal-head h2{margin:0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.form-grid label,.contact-card label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:800}.span-2{grid-column:span 2}.modal-actions{display:flex;justify-content:flex-end;gap:10px}.two-col-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}.metric-hero{min-height:230px}.aqua-bg{background:linear-gradient(150deg,#e8fbf6 0%,#fff 50%,#c7f2ee 100%)}.metric-hero>span{font-size:13px;font-weight:800;color:var(--teal)}.metric-hero h2{font-size:36px;margin:25px 0 8px}.expense-chart{display:flex;align-items:center;justify-content:space-between}.small-pie{width:190px;height:170px}.scan-banner{display:flex;gap:12px;align-items:center;background:#0e2430;color:#fff;border-radius:16px;padding:15px 18px;margin-bottom:15px}.scan-banner span{display:block;color:#c4d7d7;font-size:12px;margin-top:3px}.invoice-drop{border:1px dashed #9eb7b3;border-radius:16px;padding:25px;display:flex;flex-direction:column;align-items:center;gap:7px;color:var(--teal);background:#f8fcfb}.invoice-drop small{color:var(--muted)}.report-tabs{margin-bottom:16px;overflow:auto}.report-summary{grid-template-columns:repeat(4,1fr)}.reports-grid .chart-wrap{height:320px}.soft-panel{background:linear-gradient(145deg,#effaf7,#fff)}.soft-panel ul{padding-left:18px;color:#475569;line-height:1.8;font-size:13px}.check-list{margin-top:18px}.check-list>div{display:flex;align-items:center;gap:10px;padding:12px 0;border-bottom:1px solid #edf1f0}.check-list svg{width:19px;color:#94a3b8}.check-list .done{color:var(--teal)}.check-list span{flex:1;font-size:13px;font-weight:700}.check-list small{color:var(--teal)}.loan-hero,.device-hero,.pricing-section{background:linear-gradient(155deg,#e8fbf6 0%,#fff 46%,#bcebe5 100%);border:1px solid #cfe6e2;border-radius:28px;padding:30px;margin-bottom:18px}.loan-hero{display:flex;justify-content:space-between;align-items:center}.score-ring{width:145px;height:145px;border-radius:50%;border:14px solid #bfeae4;outline:8px solid #0f766e;display:grid;place-items:center;align-content:center;background:#fff}.score-ring strong{font-size:38px}.score-ring span{font-size:12px}.score-ring small{color:var(--muted)}.device-hero{display:flex;align-items:center;gap:30px}.device-render{width:230px;height:150px;border-radius:28px;background:linear-gradient(145deg,#102f38,#0d5f62);color:#fff;display:flex;flex-direction:column;justify-content:center;align-items:center;box-shadow:0 30px 50px rgba(13,59,65,.25);position:relative}.device-render span{font-size:13px;letter-spacing:.15em}.device-render strong{font-size:30px}.device-render i{position:absolute;right:22px;bottom:20px;width:11px;height:11px;border-radius:50%;background:#64748b}.device-render i.on{background:#4ade80;box-shadow:0 0 15px #4ade80}.device-stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-bottom:18px}.stat-tile svg{color:var(--teal);margin-bottom:20px}.stat-tile span,.stat-tile strong{display:block}.stat-tile span{font-size:12px;color:var(--muted)}.stat-tile strong{margin-top:7px}.source-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.source-grid>div{padding:16px;background:#f8faf9;border:1px solid var(--line);border-radius:16px}.source-grid strong,.source-grid small{display:block}.source-grid small{color:var(--muted);margin-top:5px}.status-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px}.status-dot.online{background:#22c55e}.notification-list{padding:8px}.notification-item{width:100%;border:0;background:#fff;display:flex;align-items:flex-start;gap:13px;text-align:left;padding:17px;border-radius:16px;position:relative}.notification-item:hover{background:#f5faf8}.notification-item.read{opacity:.65}.notification-icon{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;flex:none;background:#e5f8f4;color:var(--teal)}.notification-icon.warning{background:#fff4df;color:#d97706}.notification-icon.device{background:#e8eefc;color:#1d4ed8}.notification-icon.tax{background:#f3e8ff;color:#7e22ce}.notification-item div{flex:1}.notification-item p{margin:5px 0;font-size:13px}.notification-item small{color:#94a3b8}.notification-item>i{width:8px;height:8px;background:#ef4444;border-radius:50%;margin-top:6px}.assistant-layout{display:grid;grid-template-columns:300px 1fr;gap:18px}.assistant-side{text-align:center}.assistant-orb{width:92px;height:92px;border-radius:30px;margin:10px auto 20px;background:linear-gradient(145deg,#0f766e,#2dd4bf);display:grid;place-items:center;color:#fff;box-shadow:0 20px 40px rgba(15,118,110,.25)}.assistant-orb svg{width:44px;height:44px}.assistant-stats{display:flex;gap:10px;margin-top:30px}.assistant-stats span{flex:1;border:1px solid var(--line);border-radius:15px;padding:12px}.assistant-stats strong,.assistant-stats small{display:block}.assistant-stats small{color:var(--muted);font-size:10px;margin-top:4px}.assistant-chat{min-height:620px;display:flex;flex-direction:column}.chat-thread{flex:1;overflow:auto;padding:10px}.thread-msg{display:flex;gap:9px;max-width:75%;margin:13px 0}.thread-msg p{margin:0;padding:13px 15px;border-radius:17px;background:#eff5f3;color:#334155}.thread-msg.user{margin-left:auto}.thread-msg.user p{background:var(--teal);color:#fff}.thread-msg span{width:30px;height:30px;border-radius:10px;background:#e5f8f4;color:var(--teal);display:grid;place-items:center}.suggestion-row{display:flex;gap:8px;flex-wrap:wrap;padding:12px 0}.suggestion-row button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:9px 12px;color:#475569}.assistant-input,.chat-input{display:flex;border:1px solid var(--line);border-radius:16px;padding:6px;background:#fff}.assistant-input input,.chat-input input{flex:1;border:0;outline:0;padding:8px}.assistant-input button,.chat-input button{width:42px;border:0;border-radius:12px;background:var(--teal);color:#fff}.settings-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:18px;margin-bottom:18px}.settings-list{padding:8px}.settings-list button{width:100%;display:flex;align-items:center;gap:12px;border:0;background:#fff;padding:15px;border-radius:15px;text-align:left}.settings-list button:hover{background:#f5faf8}.settings-list button div{flex:1}.settings-list strong,.settings-list small{display:block}.settings-list small{color:var(--muted);margin-top:4px}.profile-card{text-align:center}.big-avatar{width:84px;height:84px;margin:0 auto 14px;font-size:22px}.profile-card dl{text-align:left;margin:24px 0}.profile-card dl div{padding:11px 0;border-bottom:1px solid #edf1f0}.profile-card dt{font-size:11px;color:var(--muted)}.profile-card dd{margin:4px 0 0;font-weight:700}.pricing-section{padding:38px}.section-title{text-align:center;max-width:620px;margin:0 auto 28px}.section-title h2{font-size:36px;margin:15px 0 7px}.pricing-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;align-items:stretch}.pricing-cards article{background:#fff;border:1px solid var(--line);border-radius:22px;padding:24px;display:flex;flex-direction:column}.pricing-cards article.featured{transform:translateY(-8px);border-color:#0f766e;box-shadow:0 25px 55px rgba(15,118,110,.15)}.pricing-cards article>span{font-size:11px;font-weight:900;color:var(--teal);text-transform:uppercase;letter-spacing:.08em}.pricing-cards h3{margin:12px 0}.pricing-cards strong{font-size:29px}.pricing-cards strong small{font-size:12px;color:var(--muted)}.pricing-cards ul{padding-left:18px;line-height:1.9;color:#475569;font-size:13px;flex:1}.help-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:18px}.help-cards svg{color:var(--teal);width:30px;height:30px;margin-bottom:14px}.faq-list button{width:100%;border:0;background:#fff;text-align:left;border-bottom:1px solid #edf1f0;padding:17px 0}.faq-list button div{display:flex;justify-content:space-between;align-items:center}.faq-list p{margin:12px 0 0}.faq-list .open svg{transform:rotate(180deg)}.contact-card{display:flex;flex-direction:column;gap:13px}.chat-fab{position:fixed;right:25px;bottom:25px;width:56px;height:56px;border-radius:18px;border:0;background:linear-gradient(145deg,#0f766e,#2dd4bf);color:#fff;box-shadow:0 16px 35px rgba(15,118,110,.32);z-index:60}.chat-popover{position:fixed;right:25px;bottom:92px;width:350px;height:470px;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 30px 70px rgba(15,35,45,.22);display:flex;flex-direction:column;overflow:hidden;z-index:61}.chat-head{background:var(--navy);color:#fff;padding:15px;display:flex;justify-content:space-between}.chat-head span{display:block;color:#8de2d5;font-size:11px}.chat-messages{flex:1;padding:13px;overflow:auto}.chat-bubble{max-width:85%;padding:10px 12px;border-radius:14px;background:#eef5f3;margin-bottom:9px;font-size:12px;line-height:1.5}.chat-bubble.user{background:var(--teal);color:#fff;margin-left:auto}.chat-input{margin:10px}.mobile-nav{display:none}.mobile-only{display:none!important}.toast{position:fixed;right:25px;top:90px;background:var(--navy);color:#fff;padding:13px 18px;border-radius:14px;box-shadow:0 16px 35px rgba(15,35,45,.2);z-index:100}.login-page{min-height:100vh;background:linear-gradient(180deg,#fff 0,#f7faf9 68%,#c5efea 100%)}.login-topbar{height:78px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(20px,6vw,90px)}.brand-inline{display:flex;align-items:center;gap:10px}.brand-inline small{display:block;color:var(--muted)}.login-shell{max-width:1280px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:60px;padding:55px clamp(20px,5vw,70px) 80px;align-items:center}.login-hero h1{font-size:clamp(3rem,6vw,5.4rem);max-width:800px}.login-hero>p{font-size:18px;max-width:700px}.login-benefits{display:grid;gap:12px;margin:30px 0}.login-benefits div{display:flex;align-items:center;gap:11px;font-weight:800}.login-benefits svg{color:var(--teal)}.hero-preview{padding:18px 0}.mini-window{max-width:600px;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:0 30px 70px rgba(15,60,63,.14);padding:18px}.mini-window-top{display:flex;gap:5px}.mini-window-top span{width:8px;height:8px;border-radius:50%;background:#fb7185}.mini-window-top span:nth-child(2){background:#facc15}.mini-window-top span:nth-child(3){background:#4ade80}.mini-metrics{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0}.mini-metrics div{background:#f2f8f6;border-radius:14px;padding:13px}.mini-metrics small,.mini-metrics strong{display:block}.mini-chart{height:90px;display:flex;align-items:end;gap:9px}.mini-chart i{flex:1;background:linear-gradient(#14b8a6,#b7ece5);border-radius:8px 8px 3px 3px}.mini-chart i:nth-child(1){height:35%}.mini-chart i:nth-child(2){height:58%}.mini-chart i:nth-child(3){height:45%}.mini-chart i:nth-child(4){height:75%}.mini-chart i:nth-child(5){height:60%}.mini-chart i:nth-child(6){height:83%}.mini-chart i:nth-child(7){height:98%}.login-card{background:#fff;border:1px solid var(--line);border-radius:28px;padding:34px;box-shadow:0 35px 80px rgba(15,55,60,.15)}.login-card h2{font-size:32px;margin:22px 0 8px}.login-card label{display:flex;flex-direction:column;gap:7px;font-size:12px;font-weight:800;margin:14px 0}.login-card input:not([type=checkbox]){height:48px;border:1px solid var(--line);border-radius:14px;padding:0 13px}.check-row{flex-direction:row!important;align-items:center}.form-row{display:flex;gap:10px}.between{justify-content:space-between;align-items:center}.onboarding-page{min-height:100vh;background:linear-gradient(145deg,#edf9f6,#fff,#bfeae5);display:grid;place-items:center;padding:25px}.onboarding-card{width:min(900px,100%);background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 35px 80px rgba(15,55,60,.14)}.stepper{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:32px 0}.step{display:flex;align-items:center;gap:8px;color:#94a3b8}.step>span{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line)}.step.active{color:var(--teal)}.step.active>span{background:var(--teal);color:#fff;border-color:var(--teal)}.onboarding-body{min-height:340px;padding:12px 0}.choice-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px;margin-top:22px}.choice-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:16px;padding:18px}.device-setup{display:grid;grid-template-columns:230px 1fr;gap:30px;align-items:center}.device-illustration{height:150px;border-radius:26px;background:var(--navy);color:#2dd4bf;display:grid;place-items:center;font-size:24px;font-weight:900}.status-line{margin:15px 0;color:var(--teal);font-weight:800}.done-state{text-align:center;padding:30px}.done-icon{width:75px;height:75px;border-radius:24px;background:#dff8f3;color:var(--teal);display:grid;place-items:center;margin:0 auto 18px}.wizard-actions{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:18px}
@media(max-width:1200px){.summary-grid{grid-template-columns:repeat(3,1fr)}.device-stat-grid,.source-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.desktop-only{display:none!important}.mobile-only{display:grid!important}.app-main,.app-shell.is-collapsed .app-main{margin-left:0}.sidebar{transform:translateX(-105%);width:280px}.sidebar.mobile-open{transform:translateX(0);box-shadow:30px 0 60px rgba(0,0,0,.28)}.mobile-close{display:grid!important}.page-content{padding:22px 20px 92px}.mobile-nav{display:grid;grid-template-columns:repeat(5,1fr);position:fixed;left:12px;right:12px;bottom:10px;height:68px;border:1px solid var(--line);background:rgba(255,255,255,.95);backdrop-filter:blur(14px);border-radius:20px;z-index:55;box-shadow:0 15px 35px rgba(15,35,45,.14)}.mobile-nav a,.mobile-nav button{border:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;color:#64748b;font-size:9px}.mobile-nav .active{color:var(--teal)}.chat-fab{bottom:92px}.chat-popover{bottom:155px}.dashboard-grid,.two-col-grid,.settings-grid,.assistant-layout{grid-template-columns:1fr}.summary-grid{grid-template-columns:repeat(2,1fr)}.report-summary{grid-template-columns:repeat(2,1fr)}.pricing-cards{grid-template-columns:1fr}.pricing-cards article.featured{transform:none}.help-cards{grid-template-columns:1fr}.login-shell{grid-template-columns:1fr;padding-top:25px}.login-hero h1{font-size:3.3rem}.login-card-wrap{max-width:620px;width:100%;margin:auto}.device-hero{flex-direction:column;align-items:flex-start}.loan-hero{align-items:flex-start}.assistant-chat{min-height:540px}}
@media(max-width:600px){.top-header{padding:0 14px;height:68px}.header-search{display:none}.page-content{padding:18px 14px 90px}.page-header{align-items:flex-start;flex-direction:column}.page-actions{width:100%;overflow:auto}.page-actions .primary-btn,.page-actions .secondary-btn{white-space:nowrap}.summary-grid,.report-summary{grid-template-columns:1fr 1fr}.summary-card{min-height:118px;padding:14px;display:block}.summary-icon{margin-bottom:10px}.summary-card h3{font-size:17px}.dashboard-grid{grid-template-columns:1fr}.toolbar{align-items:stretch;flex-direction:column}.form-grid{grid-template-columns:1fr}.span-2{grid-column:span 1}.expense-chart{align-items:flex-start}.small-pie{width:130px;height:140px}.loan-hero{flex-direction:column}.score-ring{width:120px;height:120px}.device-stat-grid,.source-grid{grid-template-columns:1fr 1fr}.assistant-side{display:none}.chat-popover{left:12px;right:12px;width:auto}.pricing-section{padding:24px 14px}.section-title h2{font-size:28px}.login-topbar{padding:0 18px}.login-shell{padding:20px 18px 60px}.login-hero h1{font-size:2.65rem}.login-hero>p{font-size:15px}.login-card{padding:23px}.hero-preview{display:none}.onboarding-card{padding:18px}.step small{display:none}.stepper{margin:24px 0}.device-setup{grid-template-columns:1fr}.choice-grid{grid-template-columns:1fr}.form-row.between{align-items:flex-start;flex-direction:column}.mobile-nav{left:7px;right:7px;bottom:6px}.toast{left:14px;right:14px;top:78px;text-align:center}}
